# Existing studio contact delivery remains unchanged.
# REQUIRED for hosted AgentShelf: pooled PostgreSQL connection.
DATABASE_URL=
# LOCAL ONLY. Never set on Vercel. Persistent embedded PostgreSQL.
AGENTSHELF_LOCAL_DB=.agentshelf/postgres
# REQUIRED for authentication: random 32+ character server-only secret.
BETTER_AUTH_SECRET=
# Set in production; omit for preview URL inference.
BETTER_AUTH_URL=http://localhost:3001
# Admin access requires a verified email from this server-side list.
AGENTSHELF_ADMIN_EMAILS=yulaversestudio@gmail.com
# Optional email: otherwise messages remain in outbox and verification waits.
RESEND_API_KEY=
AGENTSHELF_EMAIL_FROM=
AGENTSHELF_ALERT_EMAIL=yulaversestudio@gmail.com
# Optional Stripe TEST keys only. Live keys are refused.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional scheduler, random 24+ character secret.
CRON_SECRET=
AGENTSHELF_AUDIT_PENCE=29900
AGENTSHELF_OPTIMISATION_PENCE=79900
AGENTSHELF_MONITORING_PENCE=9900
AGENTSHELF_VAT_PRESENTATION=VAT treatment will be confirmed before payment.
# Paid AI calls default OFF. Configure current model prices before enabling.
AGENTSHELF_AI_ENABLED=false
AGENTSHELF_MAX_TEST_USD=0.05
AGENTSHELF_MAX_TESTS_PER_ORG_MONTH=30
AGENTSHELF_MAX_GLOBAL_USD_MONTH=10
AGENTSHELF_MONITORING_DAYS=30
# Each used provider requires all four values. No model/prices are invented.
OPENAI_API_KEY=
AGENTSHELF_OPENAI_MODEL=
AGENTSHELF_OPENAI_INPUT_USD_PER_MILLION=
AGENTSHELF_OPENAI_OUTPUT_USD_PER_MILLION=
GEMINI_API_KEY=
AGENTSHELF_GEMINI_MODEL=
AGENTSHELF_GEMINI_INPUT_USD_PER_MILLION=
AGENTSHELF_GEMINI_OUTPUT_USD_PER_MILLION=
ANTHROPIC_API_KEY=
AGENTSHELF_ANTHROPIC_MODEL=
AGENTSHELF_ANTHROPIC_INPUT_USD_PER_MILLION=
AGENTSHELF_ANTHROPIC_OUTPUT_USD_PER_MILLION=
PERPLEXITY_API_KEY=
AGENTSHELF_PERPLEXITY_MODEL=
AGENTSHELF_PERPLEXITY_INPUT_USD_PER_MILLION=
AGENTSHELF_PERPLEXITY_OUTPUT_USD_PER_MILLION=
# Required for Perplexity: configured per-request/search fee for the chosen model.
AGENTSHELF_PERPLEXITY_REQUEST_USD=
